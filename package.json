{
  "name": "cv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zweisprachiger, ATS-optimierter Lebenslauf – strukturierte Quelldaten -> JSON Resume -> Typst-PDF",
  "scripts": {
    "gen:schema": "tsx src/gen-schema.ts",
    "merge": "tsx src/merge.ts",
    "validate": "tsx src/validate.ts",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run gen:schema && npm run merge && npm run validate",
    "build": "tsx src/build.ts",
    "watch": "tsx src/watch.ts",
    "clean": "rm -rf dist generated"
  },
  "dependencies": {
    "@jsonresume/schema": "^1.2.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
